<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>

    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            margin: 0;
        }

        header, footer {
            background: #174a7e;
            color: white;
            text-align: center;
            padding: 15px;
        }

        main {
            width: 70%;
            margin: 25px auto;
            background: white;
            padding: 20px;
        }

        input, select, textarea {
            padding: 8px;
            margin: 5px 0;
        }

        button {
            background: #174a7e;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
        }

        .error {
            color: red;
        }
    </style>
</head>

<body>
    <header>
        <h2>Feedback Management System</h2>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>© 2026 Feedback Management System</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>